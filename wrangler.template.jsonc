/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Copy this file to wrangler.jsonc and fill in your credentials.
 * wrangler.jsonc is gitignored — it will not be committed.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "navihive",
  "main": "worker/index.ts",
  "compatibility_date": "2025-04-05",
  "assets": {
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
  },
  // D1数据库绑定 — 替换 database_id 为你的实际ID
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "navigation-db",
      "database_id": "YOUR_D1_DATABASE_ID",
    },
  ],
  // 以下变量仅用于本地开发
  // 生产环境请通过 `wrangler secret put` 设置：
  //   wrangler secret put AUTH_USERNAME
  //   wrangler secret put AUTH_PASSWORD
  //   wrangler secret put AUTH_SECRET
  "vars": {
    // 启用认证；设为 "false" 可关闭整个登录墙
    "AUTH_ENABLED": "true",
    // 只读路由是否也要求登录：
    //   "false"（默认）→ 开放游客模式，未登录可浏览 is_public=1 内容，登录页显示「游客访问」入口
    //   "true"         → 完全私密，所有内容（含只读）都需要登录，登录页不显示游客入口
    "AUTH_REQUIRED_FOR_READ": "false",
  },
}
